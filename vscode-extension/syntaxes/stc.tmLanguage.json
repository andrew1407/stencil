{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Stencil script",
  "scopeName": "source.stc",
  "patterns": [
    { "include": "#color" },
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#use-stencil" },
    { "include": "#stencil-def" },
    { "include": "#source-spec" },
    { "include": "#save-target" },
    { "include": "#param" },
    { "include": "#directive-source" },
    { "include": "#directive-output" },
    { "include": "#directive" },
    { "include": "#filter-mode" },
    { "include": "#line-style" },
    { "include": "#crop-key" },
    { "include": "#number" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "color": {
      "comment": "A hex colour is the one '#' word that is not a comment; longest form first.",
      "match": "#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{4}|[0-9a-fA-F]{3})(?![0-9a-fA-F])",
      "name": "constant.other.color.stc"
    },
    "comment": {
      "match": "#(?!(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})(?![0-9a-fA-F])).*$",
      "name": "comment.line.number-sign.stc"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.stc",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.stc" }
      ]
    },
    "use-stencil": {
      "comment": "@use stencil <name>: the word run after the two keywords names a template.",
      "match": "(?i)(@use)[ \\t]+(stencil)\\b[ \\t]*([^:#\\n]*[^:#\\n \\t])?",
      "captures": {
        "1": { "name": "keyword.control.directive.stc" },
        "2": { "name": "keyword.control.directive.stc" },
        "3": { "name": "entity.name.function.stc" }
      }
    },
    "stencil-def": {
      "match": "(?i)(@stencil)\\b[ \\t]*([^:#\\n]*[^:#\\n \\t])?",
      "captures": {
        "1": { "name": "entity.name.type.stc" },
        "2": { "name": "entity.name.function.stc" }
      }
    },
    "source-spec": {
      "comment": "The spec @source opens: a path, a glob, a directory or a URL, up to its ':'.",
      "match": "(?i)(@source)\\b[ \\t]*([^:#\\n]*[^:#\\n \\t])?",
      "captures": {
        "1": { "name": "keyword.control.source.stc" },
        "2": { "name": "string.unquoted.source.stc" }
      }
    },
    "save-target": {
      "match": "(?i)(@save)\\b[ \\t]*([^:#\\n]*[^:#\\n \\t])?",
      "captures": {
        "1": { "name": "keyword.control.output.stc" },
        "2": { "name": "string.unquoted.target.stc" }
      }
    },
    "param": {
      "match": "(?<![A-Za-z0-9_@])@\\d+(?![A-Za-z0-9_])",
      "name": "variable.parameter.stc"
    },
    "directive-source": {
      "match": "(?i)@source\\b",
      "name": "keyword.control.source.stc"
    },
    "directive-output": {
      "comment": "Writing the result out and walking the history: the directives with no edit.",
      "match": "(?i)@(?:save|undo|redo)\\b",
      "name": "keyword.control.output.stc"
    },
    "directive": {
      "match": "(?i)@(?:source|stencil|use|crop|filter|line|rect|layout|save|frame|undo|redo)\\b",
      "name": "keyword.control.directive.stc"
    },
    "filter-mode": {
      "match": "(?i)(?<=@filter)([ \\t]+)(bw|sepia|invert|contour|none)\\b",
      "captures": {
        "2": { "name": "constant.language.filter.stc" }
      }
    },
    "line-style": {
      "match": "(?i)(?<![A-Za-z0-9_@-])(solid|dashed|dotted|fill|point|transparent|combine|replace)(?![A-Za-z0-9_-])",
      "name": "storage.modifier.style.stc"
    },
    "crop-key": {
      "match": "(?i)(?<![A-Za-z0-9_@-])(x1|x2|y1|y2|aspect)(?=[ \\t]*=)",
      "name": "variable.other.key.stc"
    },
    "number": {
      "match": "(?i)(?<![A-Za-z0-9_.])(-?\\d+(?:\\.\\d+)?)(px|cm|mm|in|%)?",
      "captures": {
        "1": { "name": "constant.numeric.stc" },
        "2": { "name": "keyword.other.unit.stc" }
      }
    },
    "punctuation": {
      "match": "[(),:;=]",
      "name": "punctuation.separator.stc"
    }
  }
}
