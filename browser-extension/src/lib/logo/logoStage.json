    "waterShow":   { "effect": "water",  "accents": ["turquoise", "aqua", "sky", "blue"], "motion": "water" },
    "dustySpot":   { "effect": "dust",   "accents": ["grey", "bluegray"], "motion": "particles" },
    "makeItSmall": { "effect": "shrink", "accents": ["grass", "green"] },
    "punchToBloat": { "effect": "grow",   "accents": ["brown"] },
    "chaseMe":     { "effect": "follow", "customHex": "#ffffff" },
