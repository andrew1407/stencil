# Stencil collaboration server configuration.
# Copy to .env and adjust. Real environment variables override .env values.

# HTTP/WebSocket listener.
LISTEN_ADDR=:8090

# Raw-TCP (NDJSON) feed listener for the desktop (QTcpSocket) and CLI (std.Io.net):
# live "project created / updated / deleted" events while a client is connected.
TCP_ADDR=:8091

# Postgres connection string (pgx). Required.
DATABASE_URL=postgres://stencil:stencil@localhost:5432/stencil?sslmode=disable

# Postgres pool. Unset means pgx decides (max(4, NumCPU), floored at 16 here) —
# raise DB_MAX_CONNS when the REST surface outgrows it, and
# keep it under the server's own max_connections. DB_MIN_CONNS keeps that many
# connections warm (0 = pgx default). DB_STATEMENT_TIMEOUT is a server-side cap
# in SECONDS on one statement, so a runaway query cannot hold its connection
# forever; 0/unset leaves the database's own setting alone.
#DB_MAX_CONNS=16
#DB_MIN_CONNS=0
#DB_STATEMENT_TIMEOUT=0

# Redis URL for cross-instance event fan-out. Optional: when empty the
# server uses an in-process bus (single-instance only).
REDIS_URL=redis://localhost:6379/0

# go-redis client sizing for that URL. Unset means the library decides
# (PoolSize 10*NumCPU, 5 s dial, 3 s read/write). REDIS_IO_TIMEOUT covers reads
# and writes together; both timeouts are in SECONDS, 0/unset = the default.
#REDIS_POOL_SIZE=0
#REDIS_DIAL_TIMEOUT=0
#REDIS_IO_TIMEOUT=0
# How long a new subscription waits for Redis to acknowledge it, in seconds; a
# publish that beats the acknowledgement is lost even to this instance's feeds.
#REDIS_SUBSCRIBE_TIMEOUT_SECONDS=5

# Root directory for the file store (image bytes). It is path-confined
# (traversal-proof), NOT encrypted. A relative path resolves against the working
# directory — in a container with no mounted volume the bytes are lost on
# restart, and the server logs a WARN at boot. Set an absolute path in production.
FILESTORE_ROOT=./data/filestore

# POST /auth/token requires an admin token (X-Admin-Token header or
# Authorization: Bearer) — issuance is never open by default. Leave empty and
# the server generates a random per-boot token and prints it once at startup.
ADMIN_TOKEN=

# DANGER — explicit opt-in to OPEN token issuance. When true, POST /auth/token
# succeeds with no bearer at all: anyone who can reach the server can mint a
# token, and a token grants the whole shared workspace (projects, chat
# transcripts, the LLM proxy). AUTH_RATE_PER_MINUTE still applies, and the
# admin token keeps working. Use only on trusted networks.
#AUTH_OPEN=false

# Comma-separated browser origins allowed to call the REST API cross-origin
# (the browser/ app and the Chrome extension). Empty (default) allows loopback
# origins only (localhost/127.x/::1); "*" reflects any origin but must be set
# explicitly. Example allowlist: http://localhost:8080
CORS_ORIGINS=

# Issued-token lifetime in hours (default 168 = 7 days).
TOKEN_TTL_HOURS=168

# Max REST request body in bytes (default 33554432 = 32 MiB).
MAX_BODY_BYTES=33554432

# Project expiration. Server projects have NO expiry by default — clients set one
# explicitly (the editor's `expire` command). PROJECT_TTL_HOURS, when > 0, stamps a
# default expiry (now + TTL) on every new project that arrives without one; 0/unset
# = off. The server sweeps expired projects (removing DB row + image bytes and
# notifying clients) at startup and every EXPIRY_SWEEP_MINUTES thereafter; set the
# interval to 0 to disable the sweep.
PROJECT_TTL_HOURS=0
EXPIRY_SWEEP_MINUTES=60
# Rows one sweep DELETE takes (max 500), and the concurrent per-project byte drops.
#SWEEP_BATCH=500
#SWEEP_WORKERS=8

# Filestore reconcile: at startup and every FILESTORE_RECONCILE_MINUTES (0 = off),
# remove project directories no project row owns and upload temp files older than
# FILESTORE_TMP_MAX_AGE_MINUTES (kept far past the longest upload).
#FILESTORE_RECONCILE_MINUTES=360
#FILESTORE_TMP_MAX_AGE_MINUTES=60

# Optional TLS. When both are set the same cert/key secures HTTPS + WSS on
# LISTEN_ADDR *and* the raw-TCP feed on TCP_ADDR (TLS 1.2 minimum).
# Leave blank only behind a trusted TLS-terminating proxy or on localhost.
TLS_CERT=
TLS_KEY=

# LLM proxy (llm-contract.md §6). The upstream credentials live ONLY here —
# clients call POST /llm/chat with their existing bearer token and never see them.
# LLM_PROVIDER picks which upstream this server speaks, using the same three wire
# mappings the clients implement:
#   anthropic     (default) — POST {base}/v1/messages, needs ANTHROPIC_API_KEY
#   ollama                  — POST {base}/api/chat, no key
#   openai-compat           — POST {base}/chat/completions, key optional
# With a key-requiring provider, no key disables the proxy: GET /llm/info then reports
# enabled=false and POST /llm/chat answers 503 {"code":"llmDisabled"}.
# Token issuance is always gated by ADMIN_TOKEN (set or per-boot generated, above),
# so the proxy enables whenever the provider is configured — every session token
# traces back to someone who held the admin token.
#LLM_PROVIDER=anthropic
#LLM_MODEL=claude-opus-5
# Defaults per provider: anthropic https://api.anthropic.com · ollama
# http://localhost:11434 · openai-compat http://localhost:1234/v1
#LLM_BASE_URL=
#LLM_MAX_TOKENS=32768
#LLM_TIMEOUT_SECONDS=120

# The upstream credential. LLM_API_KEY works for ANY provider and is the one to use.
# ANTHROPIC_API_KEY is the older name and is now honoured ONLY when LLM_PROVIDER is
# anthropic — so switching provider can never put a key you obtained from Anthropic on
# the wire to someone else's OpenAI-compatible host. Set both and LLM_API_KEY wins; set
# only ANTHROPIC_API_KEY with a non-Anthropic provider and the server logs that it is
# being ignored.
#LLM_API_KEY=
#ANTHROPIC_API_KEY=

# Spend controls. A session token lives for TOKEN_TTL_HOURS and every accepted turn
# spends the key above, so both caps are ON by default; set either to 0 to opt out.
# Over either one, POST /llm/chat answers 429 {"code":"rateLimited"} with Retry-After.
# Per-session turns per minute (bursts up to a minute's worth, then settles):
#LLM_RATE_PER_MINUTE=30
# Concurrent upstream calls server-wide (also bounds memory — each call in flight can
# hold an 8 MiB response plus its images). Refused immediately, never queued:
#LLM_MAX_IN_FLIGHT=8

# Abuse guards for the non-LLM REST writes. Over a limit the route answers
# 429 {"code":"rateLimited"} with Retry-After; set either rate to 0 to turn it off.
# Token-issuance attempts per minute, per client IP (no session exists yet):
#AUTH_RATE_PER_MINUTE=10
# Project and file writes (create, update, upload, delete) per minute, per session:
#WRITE_RATE_PER_MINUTE=120
# The Retry-After (seconds) a rate-limited answer carries; a bucket refills per minute.
#RETRY_AFTER_SECONDS=60
# ...and the one POST /llm/chat carries when LLM_MAX_IN_FLIGHT is full.
#LLM_BUSY_RETRY_AFTER_SECONDS=5
# Minutes an untouched bucket (of any limiter here and HELLO_RATE_PER_MINUTE's) is
# kept before it is swept; at least 1, the time a bucket takes to refill.
#RATE_BUCKET_IDLE_MINUTES=10

# Failed WS/TCP `hello` handshakes per minute, per client IP. The feed socket
# accepts any origin (the bearer token in the hello frame is the auth), so this
# is what stops a page brute-forcing tokens at line rate. A valid token spends
# nothing; over the limit the hello is refused before the token is looked up.
# 0 = off.
#HELLO_RATE_PER_MINUTE=30
# Live WS/TCP connections one client IP may hold at once; the next one is refused
# with `rateLimited` before its hello is read, so a flood of anonymous sockets is
# bounded. Every shipped client holds one feed. 0 = unlimited.
#MAX_CONNECTIONS_PER_IP=64

# Aggregate cap on bytes held in the filestore. An upload that would pass it is
# rejected with 507 Insufficient Storage. 0/unset = unlimited.
#STORAGE_QUOTA_BYTES=0
# Cap on the bytes one owner session's projects hold together (the session that
# created them), refused with the same 507. A project with no owner — or whose
# session was swept — counts only against the aggregate cap. 0/unset = unlimited.
#STORAGE_QUOTA_PER_OWNER_BYTES=0
# Cap on the bytes one session has uploaded, into ANY project (projects are a shared
# workspace), refused with the same 507. Replacing a file moves its bytes to the new
# uploader; deleting it or its project, or the session expiring, gives them back.
# Only uploads made while it is on count: a boot with it off clears every charge.
# Set it alike on every instance. 0/unset = unlimited.
#STORAGE_QUOTA_PER_SESSION_BYTES=0

# Deadline around ONE store operation, in seconds: every REST handler, the
# per-request token lookup, and the hello's.
# Bounds how long a stuck query can hold a database connection (the HTTP
# server's own read/write timeouts are 5 minutes, which is far too long for that).
#OP_TIMEOUT_SECONDS=10

# Comma-separated networks (or bare addresses) of proxies whose X-Forwarded-For
# this server believes. Set this when running behind a TLS-terminating proxy:
# otherwise every per-IP limiter keys on the proxy's address and the whole
# internet shares one bucket. Empty (default) ignores X-Forwarded-For entirely,
# so a spoofed header from an untrusted peer changes nothing.
#TRUSTED_PROXY_CIDRS=10.0.0.0/8,127.0.0.1

# Rows in a GET /projects that names no ?limit= (0..500); a full page carries a
# nextCursor, which every shipped client follows. 0 lists every project in one answer.
#PROJECTS_PAGE_SIZE=100

# Live connections. How long a fresh connection may take to send its hello
# (seconds), and events queued per feed before one drops.
#HELLO_TIMEOUT_SECONDS=10
#BUS_SUB_BUFFER=64
# The deadline, in seconds, on one goodbye frame (the shutdown notice, a token
# expiry), so a peer that stopped reading cannot hold the drain; at most
# SHUTDOWN_TIMEOUT_SECONDS. And the shortest gap, in seconds, between two
# "dropped message(s) to a slow subscriber" warnings; each one counts the drops
# since the one before.
#HUB_NOTICE_TIMEOUT_SECONDS=1
#BUS_DROP_WARN_INTERVAL_SECONDS=30

# Live transports, in seconds: the WebSocket keepalive ping and the pong wait
# that reaps a dead peer; a TCP feed silent this long is reaped; one TCP
# frame's write deadline (a peer that stops reading cannot pin its writer).
#WS_PING_SECONDS=30
#WS_PONG_TIMEOUT_SECONDS=10
#TCP_IDLE_TIMEOUT_SECONDS=300
#TCP_WRITE_TIMEOUT_SECONDS=30

# HTTP server timeouts, in seconds (the read/write ones fit a 32 MiB upload on a
# slow link and an LLM proxy call; WebSocket editors are not subject to them),
# and the drain after SIGTERM.
#HTTP_READ_HEADER_TIMEOUT_SECONDS=10
#HTTP_READ_TIMEOUT_SECONDS=300
#HTTP_WRITE_TIMEOUT_SECONDS=300
#HTTP_IDLE_TIMEOUT_SECONDS=120
#SHUTDOWN_TIMEOUT_SECONDS=10
