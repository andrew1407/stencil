# Stencil MCP server — configuration template.
#
# Copy this to `.env` (which is gitignored) beside the stencil-mcp binary, or in this mcp/
# directory of the checkout it was built from — never read from the directory the server is
# started in. Every value is OPTIONAL: sensible defaults are used when unset. Precedence,
# lowest to highest:
#
#   built-in defaults  <  this .env file  <  process env / mcpServers "env"  <  --surface arg
#
# and a per-call `surface` parameter on a tool overrides the default for that one call.

# Default delivery surface(s) for stencil_edit results. An env var is a STRING, so use a
# comma list (a bracketed ["cli","browser"] string is also accepted). The per-call
# `surface` tool parameter additionally takes a real JSON array.
# The CLI always does the pixel work; these control where the result is delivered:
#   cli           write the output file (always implied)
#   desktop       also launch the Qt desktop app showing the result
#   browser       also build/open an editor launch URL with the result loaded
#   browser-live  delegated: live driving is handled by the stencil-operator agent
#   extension     delegated: page scanning is handled by the stencil-operator agent
STENCIL_SURFACES=cli,browser

# Path to the Stencil CLI binary. Default: auto-discovered (the cli/zig-out/bin/stencil of
# the checkout this server was built in, then `stencil` on PATH).
#STENCIL_CLI=/absolute/path/to/stencil

# Per-invocation deadline for one CLI run, in seconds. A slow or hung CLI is killed at
# the deadline and reported as an error rather than pinning the tool call. Default: 120.
#STENCIL_CLI_TIMEOUT_SECONDS=120

# How many CLI runs may go at once across every tool call; the rest wait. Default: 2.
#STENCIL_MCP_MAX_CONCURRENT_CLI=2

# The directories every write must land in, as a path list (`:`-separated; `;` on
# Windows). Used when the MCP client offers no workspace roots of its own. Default: the
# directory the server was started in. A relative tool path resolves against the first.
#STENCIL_MCP_ROOTS=/home/me/work:/home/me/scratch

# ── Collaboration servers (stencil_edit server/remote, stencil_projects) ──
# The servers a tool call may reach, as a comma list of origins. Unset = none: every
# `server`/`remote` URL is refused, since a model-chosen URL could carry a local file away.
#STENCIL_MCP_SERVERS=http://localhost:8090

# The token for each allowed server, as origin=token pairs, comma-separated. Handed to the
# CLI in its environment (STENCIL_SERVER_TOKENS), never on its command line — a tool call
# never names or sees a token.
#STENCIL_MCP_SERVER_TOKENS=http://localhost:8090=your-session-token

# Path to the Qt desktop binary (used by the `desktop` surface).
# Default: <checkout>/desktop/build/stencil, the checkout this server was built in.
#STENCIL_DESKTOP=/absolute/path/to/stencil

# Base URL of the served browser editor. Only needed for the `browser`/`browser-live`/
# `extension` surfaces, and only if the editor is NOT on the default below (e.g. you ran
# `ADDR=0.0.0.0 PORT=3000 npm run serve`, or it's on another host). Ignored for cli/desktop.
#STENCIL_BROWSER_URL=http://localhost:8080

# Auto-open the browser launch URL with the OS opener (open / xdg-open). When false the
# URL is just returned in the tool result for you to open. The URL carries the image, so
# only a small result gets one (about 32 KiB returned, 96 KiB opened). Default: false.
#STENCIL_AUTO_OPEN=false

# ── LLM assistant (stencil_prompt) ──
# See ../llm-contract.md (§5). The built-in transport is plain http:// only — use a
# local provider (Ollama / LM Studio) or an http:// Stencil collaboration server. Having no
# TLS, it also refuses to send Authorization / x-api-key anywhere but loopback, so keep any
# endpoint that needs a key on this machine (or behind a local TLS proxy).
# These are operator settings: a stencil_prompt caller can override the model, never the
# provider or the endpoint.
# Provider: ollama (default) | openai-compat | stencil-server.
#STENCIL_LLM_PROVIDER=ollama

# Endpoint. Defaults per provider: ollama http://localhost:11434, openai-compat
# http://localhost:1234/v1 (already includes /v1). Ignored for stencil-server.
#STENCIL_LLM_BASE_URL=http://localhost:11434

# Model name. Empty = whatever the provider/server defaults to.
#STENCIL_LLM_MODEL=llama3.2-vision

# openai-compat only: sent as `Authorization: Bearer …` (LM Studio needs none).
#STENCIL_LLM_API_KEY=

# stencil-server only: the collaboration server proxying Anthropic, plus its bearer token.
#STENCIL_LLM_SERVER_URL=http://localhost:8090
#STENCIL_LLM_SERVER_TOKEN=
