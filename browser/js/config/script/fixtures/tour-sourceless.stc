# With no @source, the directives apply to whatever is already open:
# the current project in the editors, or the -i input on the CLI.

@stencil lines and rect:
    @use line #cccccc dashed, fill aqua
    @line (23, 14) (14px, 50%)

@rect (23, 14) (56, 90)
@use stencil lines and rect:
@layout https://example.com/layout.json
@save
