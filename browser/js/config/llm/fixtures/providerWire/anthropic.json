[
  {
    "name": "plain single turn — empty model sends serverDefaults.model and max_tokens, x-api-key + anthropic-version, no Authorization",
    "provider": "anthropic",
    "settings": {
      "baseUrl": "https://api.anthropic.test",
      "apiKey": "sk-ant-test-0123456789abcdef"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "crop 10% off the left"
        }
      ]
    },
    "expectUrl": "https://api.anthropic.test/v1/messages",
    "expectHeaders": {
      "x-api-key": "sk-ant-test-0123456789abcdef",
      "anthropic-version": "2023-06-01"
    },
    "expectBody": {
      "model": "claude-opus-5",
      "max_tokens": 32768,
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "crop 10% off the left"
            }
          ]
        }
      ]
    },
    "response": {
      "model": "claude-opus-5",
      "stop_reason": "end_turn",
      "content": [
        {
          "type": "text",
          "text": "{\"version\":1,\"actions\":[]}"
        }
      ]
    },
    "expectReply": "{\"version\":1,\"actions\":[]}"
  },
