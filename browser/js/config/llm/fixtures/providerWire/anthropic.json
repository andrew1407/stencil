  {
    "name": "images follow the turn's text block as base64 sources; history turns are text blocks by role",
    "provider": "anthropic",
    "settings": {
      "baseUrl": "https://api.anthropic.test",
      "apiKey": "sk-ant-test-0123456789abcdef"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "what is this?",
          "images": [
            {
              "mediaType": "image/png",
              "data": "aGk="
            },
            {
              "mediaType": "image/jpeg",
              "data": "/9j/"
            }
          ]
        },
        {
          "role": "assistant",
          "text": "a cat"
        },
        {
          "role": "user",
          "text": "crop to it"
        }
      ]
    },
    "expectUrl": "https://api.anthropic.test/v1/messages",
    "expectHeaders": {
      "x-api-key": "sk-ant-test-0123456789abcdef",
      "anthropic-version": "2023-06-01"
    },
    "expectBody": {
      "model": "claude-opus-5",
      "max_tokens": 32768,
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "what is this?"
            },
            {
              "type": "image",
              "source": {
                "type": "base64",
                "media_type": "image/png",
                "data": "aGk="
              }
            },
            {
              "type": "image",
              "source": {
                "type": "base64",
                "media_type": "image/jpeg",
                "data": "/9j/"
              }
            }
          ]
        },
        {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "a cat"
            }
          ]
        },
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "crop to it"
            }
          ]
        }
      ]
    },
    "response": {
      "model": "claude-opus-5",
      "stop_reason": "end_turn",
      "content": [
        {
          "type": "text",
          "text": "ok"
        }
      ]
    },
    "expectReply": "ok"
  },
