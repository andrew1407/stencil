  {
    "name": "image attachments become a content-parts array with data: URLs",
    "divergences": {
      "cli": "hardcodes data:image/png for every attachment part (its attachments are always PNG-encoded snapshots) — the fixture's image/jpeg mediaType is not representable"
    },
    "comment": "mediaType survives inside the data: URL; text part always comes first",
    "provider": "openai",
    "settings": {
      "baseUrl": "http://lmstudio.test:1234/v1",
      "model": "qwen2-vl"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "what is in these?",
          "images": [
            {
              "mediaType": "image/png",
              "data": "aGVsbG8tcGl4ZWxz"
            },
            {
              "mediaType": "image/jpeg",
              "data": "d29ybGQtcGl4ZWxz"
            }
          ]
        }
      ]
    },
    "expectUrl": "http://lmstudio.test:1234/v1/chat/completions",
    "expectBody": {
      "model": "qwen2-vl",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "what is in these?"
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "data:image/png;base64,aGVsbG8tcGl4ZWxz"
              }
            },
            {
              "type": "image_url",
              "image_url": {
                "url": "data:image/jpeg;base64,d29ybGQtcGl4ZWxz"
              }
            }
          ]
        }
      ]
    },
    "response": {
      "choices": [
        {
          "message": {
            "content": "two test images"
          }
        }
      ]
    },
    "expectReply": "two test images"
  },
