[
  {
    "name": "plain single turn, no api key — content stays a bare string",
    "provider": "openai",
    "settings": {
      "baseUrl": "http://lmstudio.test:1234/v1",
      "model": "qwen2-vl"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "crop 10% off the left"
        }
      ]
    },
    "expectUrl": "http://lmstudio.test:1234/v1/chat/completions",
    "expectBody": {
      "model": "qwen2-vl",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": "crop 10% off the left"
        }
      ]
    },
    "response": {
      "choices": [
        {
          "message": {
            "role": "assistant",
            "content": "{\"version\":1,\"actions\":[]}"
          }
        }
      ]
    },
    "expectReply": "{\"version\":1,\"actions\":[]}"
  },
  {
    "name": "api key becomes Authorization: Bearer",
    "provider": "openai",
    "settings": {
      "baseUrl": "http://lmstudio.test:1234/v1",
      "model": "qwen2-vl",
      "apiKey": "test-key-123"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "hi"
        }
      ]
    },
    "expectUrl": "http://lmstudio.test:1234/v1/chat/completions",
    "expectAuthorization": "Bearer test-key-123",
    "expectBody": {
      "model": "qwen2-vl",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": "hi"
        }
      ]
    },
    "response": {
      "choices": [
        {
          "message": {
            "content": "hello"
          }
        }
      ]
    },
    "expectReply": "hello"
  },
