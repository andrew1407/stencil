[
  {
    "name": "plain single turn, explicit model",
    "provider": "ollama",
    "settings": {
      "baseUrl": "http://ollama.test:11434",
      "model": "llama3.2-vision"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "crop 10% off the left"
        }
      ]
    },
    "expectUrl": "http://ollama.test:11434/api/chat",
    "expectBody": {
      "model": "llama3.2-vision",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": "crop 10% off the left"
        }
      ]
    },
    "response": {
      "model": "llama3.2-vision",
      "message": {
        "role": "assistant",
        "content": "{\"version\":1,\"actions\":[]}"
      },
      "done": true
    },
    "expectReply": "{\"version\":1,\"actions\":[]}"
  },
  {
    "name": "multi-turn history is replayed in order after the system turn",
    "provider": "ollama",
    "settings": {
      "baseUrl": "http://ollama.test:11434",
      "model": "llama3.2-vision"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "rotate it"
        },
        {
          "role": "assistant",
          "text": "Done — anything else?"
        },
        {
          "role": "user",
          "text": "now make it black and white"
        }
      ]
    },
    "expectUrl": "http://ollama.test:11434/api/chat",
    "expectBody": {
      "model": "llama3.2-vision",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": "rotate it"
        },
        {
          "role": "assistant",
          "content": "Done — anything else?"
        },
        {
          "role": "user",
          "content": "now make it black and white"
        }
      ]
    },
    "response": {
      "message": {
        "role": "assistant",
        "content": "ok"
      }
    },
    "expectReply": "ok"
  },
  {
    "name": "image attachments become bare base64 strings in \"images\"",
    "comment": "ollama takes raw base64 with NO mediaType — the mediaType from the canonical message is dropped",
    "provider": "ollama",
    "settings": {
      "baseUrl": "http://ollama.test:11434",
      "model": "llama3.2-vision"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "what is in these?",
          "images": [
            {
              "mediaType": "image/png",
              "data": "aGVsbG8tcGl4ZWxz"
            },
            {
              "mediaType": "image/jpeg",
              "data": "d29ybGQtcGl4ZWxz"
            }
          ]
        }
      ]
    },
    "expectUrl": "http://ollama.test:11434/api/chat",
    "expectBody": {
      "model": "llama3.2-vision",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": "what is in these?",
          "images": [
            "aGVsbG8tcGl4ZWxz",
            "d29ybGQtcGl4ZWxz"
          ]
        }
      ]
    },
    "response": {
      "message": {
        "role": "assistant",
        "content": "two test images"
      }
    },
    "expectReply": "two test images"
  },
