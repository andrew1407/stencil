  {
    "name": "reply extraction: 200 body without message.content is a typed badReply error",
    "divergences": {
      "cli": "same typed bad_reply kind; its detail is the clipped raw body, not the browser's message",
      "mcp": "same BadReply kind; its own phrasing ('unexpected LLM response: no message.content string …')",
      "pystencil": "same typed error; its own phrasing ('malformed ollama response: no reply text')"
    },
    "comment": "an error-shaped {\"error\":…} body on HTTP 200 is a typed badReply, never an empty reply",
    "provider": "ollama",
    "settings": {
      "baseUrl": "http://ollama.test:11434",
      "model": "llava"
    },
    "chat": {
      "system": "You are the Stencil image-editing assistant. Answer with a v1 op-plan.",
      "messages": [
        {
          "role": "user",
          "text": "hi"
        }
      ]
    },
    "expectUrl": "http://ollama.test:11434/api/chat",
    "expectBody": {
      "model": "llava",
      "stream": false,
      "messages": [
        {
          "role": "system",
          "content": "You are the Stencil image-editing assistant. Answer with a v1 op-plan."
        },
        {
          "role": "user",
          "content": "hi"
        }
      ]
    },
    "response": {
      "error": "model failed to load"
    },
    "expectError": {
      "kind": "badReply",
      "message": "malformed ollama response (no message.content)"
    }
  }
]
