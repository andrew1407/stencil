[
  {
    "name": "unknown top-level fields are dropped on read",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "hello"
        }
      ],
      "title": "my chat",
      "pinned": true
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "hello"
        }
      ]
    }
  },
  {
    "name": "a stray images field on a stored message is dropped, never written back",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "look",
          "images": [
            {
              "mediaType": "image/png",
              "data": "aGk="
            }
          ]
        }
      ]
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "look"
        }
      ]
    }
  },
  {
    "name": "unknown extra fields on a message are stripped to role+text",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "assistant",
          "text": "hi",
          "meta": {
            "tokens": 12
          }
        }
      ]
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "assistant",
          "text": "hi"
        }
      ]
    }
  },
  {
    "name": "roles other than user/assistant are dropped",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "system",
          "text": "you are…"
        },
        {
          "role": "user",
          "text": "kept"
        },
        {
          "role": "tool",
          "text": "dropped"
        }
      ]
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "kept"
        }
      ]
    }
  },
  {
    "name": "a message without a string text is dropped",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": 7
        },
        {
          "role": "user"
        },
        null,
        {
          "role": "assistant",
          "text": "kept"
        }
      ]
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "assistant",
          "text": "kept"
        }
      ]
    }
  },
  {
    "name": "the §7 continuation note never comes back from storage",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "[The working image is now the picture those actions loaded — continue with it.]"
        },
        {
          "role": "user",
          "text": "[The working image is now something else entirely — carry on.]"
        },
        {
          "role": "user",
          "text": "kept"
        }
      ]
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "user",
          "text": "kept"
        }
      ]
    }
  },
  {
    "name": "an assistant turn that is a raw op-plan (incl. ask plans) is dropped",
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "assistant",
          "text": "{\"version\":1,\"actions\":[{\"op\":\"rotate\"}]}"
        },
        {
          "role": "assistant",
          "text": "{\"version\":1,\"ask\":{\"question\":\"which?\"}}"
        },
        {
          "role": "assistant",
          "text": "Rotated it."
        }
      ]
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 42,
      "messages": [
        {
          "role": "assistant",
          "text": "Rotated it."
        }
      ]
    }
  },
