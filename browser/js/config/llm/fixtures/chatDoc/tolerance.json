  {
    "name": "savedAt as a numeric string is coerced",
    "divergences": {
      "bot": "ChatDocument.TryParse only reads savedAt when ValueKind is Number — a numeric string reads as 0, not 123"
    },
    "doc": {
      "version": 1,
      "savedAt": "123",
      "messages": []
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 123,
      "messages": []
    }
  },
  {
    "name": "savedAt as garbage reads as 0",
    "doc": {
      "version": 1,
      "savedAt": "yesterday",
      "messages": []
    },
    "expectParsed": {
      "version": 1,
      "savedAt": 0,
      "messages": []
    }
  },
  {
    "name": "version 2 is treated as missing (null)",
    "doc": {
      "version": 2,
      "savedAt": 42,
      "messages": []
    },
    "expectParsed": null
  },
  {
    "name": "missing version is treated as missing (null)",
    "doc": {
      "savedAt": 42,
      "messages": []
    },
    "expectParsed": null
  },
  {
    "name": "string version \"1\" is NOT version 1 (strict compare) — null",
    "doc": {
      "version": "1",
      "savedAt": 42,
      "messages": []
    },
    "expectParsed": null
  },
  {
    "name": "messages that is not an array — null",
    "divergences": {
      "bot": "ChatDocument.TryParse tolerates a non-array messages value and returns a document with zero messages, where the reference treats the whole doc as missing (null)"
    },
    "doc": {
      "version": 1,
      "savedAt": 42,
      "messages": "nope"
    },
    "expectParsed": null
  },
  {
    "name": "a non-object document — null",
    "doc": 17,
    "expectParsed": null
  },
  {
    "name": "invalid JSON string input parses to null",
    "docString": "{\"version\":1,\"messages\":",
    "expectParsed": null
  },
  {
    "name": "a valid document as a JSON string parses the same as the object form",
    "docString": "{\"version\":1,\"savedAt\":9,\"messages\":[{\"role\":\"user\",\"text\":\"hi\"}]}",
    "expectParsed": {
      "version": 1,
      "savedAt": 9,
      "messages": [
        {
          "role": "user",
          "text": "hi"
