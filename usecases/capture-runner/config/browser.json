    "create-blank": {
      "stepMs": 400,
      "holdMs": 700,
      "points": [
        [
          0.2,
          0.25
        ],
        [
          0.55,
          0.6
        ],
        [
          0.8,
          0.3
        ]
      ],
      "fps": 8,
      "width": 900
    },
    "assistant-turn": {
      "typeDelayMs": 28,
      "holdMs": 1800
    },
    "script-run": {
      "typeDelayMs": 18,
      "holdMs": 1600
    }
  },
  "timeouts": {
    "stubReplyMs": 20000,
    "realReplyMs": 120000,
    "loadMs": 15000
  }
