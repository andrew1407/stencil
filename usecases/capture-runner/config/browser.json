      "width": 1280,
      "height": 800
    },
    "launch": {
      "width": 1000,
      "height": 640
    }
  },
  "modals": [
    {
      "name": "connect-modal",
      "key": "servers",
      "overlay": "connect-modal-overlay"
    },
    {
      "name": "open-image-modal",
      "key": "open-image",
      "overlay": "open-image-modal-overlay"
    },
    {
      "name": "help-modal",
      "key": "help",
      "overlay": "info-modal-overlay"
    },
    {
      "name": "assistant-settings-modal",
      "key": "assistant-settings",
      "overlay": "chat-settings-overlay"
    },
    {
      "name": "crop-modal",
      "key": "crop",
      "overlay": "crop-modal-overlay",
      "trigger": "#crop-image",
      "ready": "#crop-image-el",
      "image": "botIcon"
    },
    {
      "name": "links-modal",
      "key": "links",
      "overlay": "links-modal-overlay"
    },
    {
      "name": "description-modal",
      "key": "description",
      "overlay": "description-overlay"
    },
    {
      "name": "keywords-modal",
      "key": "keywords",
      "overlay": "keywords-overlay"
    }
