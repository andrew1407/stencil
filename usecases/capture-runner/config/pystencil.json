{
  "theme": {
    "mode": "dark"
  },
  "page": {
    "width": 1400,
    "height": 1000,
    "scaleFactor": 2
  },
  "sessions": {
    "root": "/tmp/stencil-term/pystencil",
    "title": "pystencil",
    "rows": 28,
    "cols": 100,
    "typeDelayMs": 30,
    "quietMs": 800,
    "gif": {
      "width": 1000
    },
    "bin": {
      "stencil": "cli/zig-out/bin/stencil"
    },
    "links": {
      "lib/pystencil": "pystencil/pystencil"
    },
    "env": {
      "PYTHONPATH": "{root}/lib",
      "PYTHONDONTWRITEBYTECODE": "1"
    },
    "files": {
      "icon.png": "bot/assets/icon.png",
      "photos/banner.jpg": "bot/assets/description.jpg",
      "photos/logo.png": "bot/assets/icon.png",
      "photos/badge.png": "browser-extension/icons/icon-128.png"
    },
    "texts": {
      "frame-all.stc": [
        "# Frame every picture in photos/ and warm it up.",
        "@source photos/:",
        "    @crop 6%",
        "    @filter sepia",
        "    @use line #c81e1e 4px dashed",
        "    @rect (10%, 10%) (90%, 90%)",
        "    @save out/"
      ],
      "frame.py": [
        "from pystencil import Editor, Layout, Line, Point",
        "",
        "ed = Editor().load(\"icon.png\").crop(\"x1=8% x2=92% y1=8% y2=92%\").apply_filter(\"sepia\")",
        "w, h = ed.image_size",
        "corners = [(.2, .2), (.8, .2), (.8, .8), (.2, .8), (.2, .2)]",
        "box = Line(points=[Point(x * w, y * h) for x, y in corners], color=\"#dc2626\",",
        "           thickness=5, style=\"dashed\")",
        "ed.draw(Layout(image_width=w, image_height=h, lines=[box]))",
        "ed.save(\"out/icon-api.png\")",
        "print(\"saved out/icon-api.png\", ed.image_size)"
      ],
      "share.py": [
        "import os",
        "from pystencil import Editor, ServerConnection",
        "",
        "conn = ServerConnection(os.environ[\"STENCIL_SERVER_URL\"], os.environ[\"STENCIL_SERVER_TOKEN\"]).connect()",
        "project = conn.create_remote_project(\"Roof survey\", image=Editor().load(\"icon.png\").result())",
        "print(\"created\", project[\"name\"], \"version\", project[\"version\"])",
        "",
        "ed = Editor().load(conn.get_file(project[\"id\"], \"original\")).apply_filter(\"sepia\")",
        "saved = conn.save_remote_project(project[\"id\"], version=project[\"version\"],",
        "                                 layout=ed.layout().to_dict(), image=ed.result())",
        "print(\"saved the sepia take as version\", saved[\"version\"])"
      ]
    },
    "serverNames": [
      "Roof survey"
    ],
    "scenes": [
      {
        "name": "oneshot",
        "steps": [
          {
            "line": "python3 -m pystencil -i icon.png -c \"x1=10% x2=90% y1=10% y2=90%\" -r 1 --filter sepia out/icon-framed.png",
            "until": "\\n\\$$",
            "timeout": 90
          },
          {
            "line": "python3 -m pystencil -i missing.png out/x.png",
            "until": "\\n\\$$"
          },
          {
            "shot": "oneshot",
            "fit": "rows"
          }
        ],
        "cols": 116
      },
      {
        "name": "repl",
        "steps": [
          {
            "line": "python3 -m pystencil --console",
            "quietMs": 1500
          },
          {
            "line": "/upload icon.png",
            "until": "\\n[^/$\\n][^\\n]*$"
          },
          {
            "line": "/crop x1=10% x2=90% y1=10% y2=90%",
            "until": "\\n[^/$\\n][^\\n]*$"
          },
          {
            "line": "/filter sepia",
            "until": "\\n[^/$\\n][^\\n]*$"
          },
          {
            "line": "/undo",
            "until": "\\n[^/$\\n][^\\n]*$"
          },
          {
            "line": "/save out/edited.png",
            "until": "\\n[^/$\\n][^\\n]*$"
          },
          {
            "line": "/exit",
            "until": "\\n\\$$"
          },
          {
            "shot": "repl",
            "fit": "rows"
          }
        ]
      },
      {
        "name": "editor-api",
        "steps": [
          {
            "line": "cat frame.py",
            "until": "\\n\\$$"
          },
          {
            "line": "python3 frame.py",
            "until": "\\n\\$$",
            "timeout": 60
          },
          {
            "shot": "editor-api",
            "fit": "rows",
            "keep": [
              "out/icon-api.png",
              "editor-api-result"
            ]
          }
        ]
      },
      {
        "name": "script",
        "steps": [
          {
            "line": "python3 -m pystencil --script frame-all.stc",
            "until": "\\n\\$$",
            "timeout": 60
          },
          {
            "shot": "script",
            "fit": "rows"
          }
        ]
      },
      {
        "name": "pystc",
        "steps": [
          {
            "line": "stencil --script frame-all.stc --script-emit frame-all.pystc",
            "until": "\\n\\$$"
          },
          {
            "line": "python3 frame-all.pystc && ls out/*-stencil.*",
            "until": "\\n\\$$",
            "timeout": 60
          },
          {
            "shot": "pystc",
            "fit": "rows"
          }
        ]
      },
      {
        "name": "prompt",
        "cols": 112,
        "plans": [
          "sepiaOutline"
        ],
        "env": {
          "STENCIL_LLM_PROVIDER": "openai-compat",
          "STENCIL_LLM_BASE_URL": "{stub}/v1",
          "STENCIL_LLM_MODEL": "stub"
        },
        "steps": [
          {
            "line": "python3 -m pystencil --console",
            "quietMs": 1500
          },
          {
            "line": "/upload icon.png",
            "until": "\\n[^/$\\n][^\\n]*$"
          },
          {
            "line": "/prompt {prompt}",
            "until": "Framed the S",
            "timeout": 60
          },
          {
            "line": "/exit",
            "until": "\\n\\$$"
          },
          {
            "shot": "prompt",
            "fit": "rows"
          }
        ]
      },
      {
        "name": "server",
        "server": true,
        "cols": 104,
        "env": {
          "STENCIL_SERVER_URL": "{server}",
          "STENCIL_SERVER_TOKEN": "{token}"
        },
        "steps": [
          {
            "line": "cat share.py",
            "until": "\\n\\$$"
          },
          {
            "line": "python3 share.py",
            "until": "\\n\\$$",
            "timeout": 60
          },
          {
            "shot": "server",
            "fit": "rows"
          }
        ]
      }
    ]
  }
}
