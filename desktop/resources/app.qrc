<!DOCTYPE RCC>
<!-- Embeds the browser app's config JSON directly so the desktop and browser
     read the SAME hotkeys / info / constants (single source of truth). Paths are
     relative to this .qrc file (desktop/resources/ -> ../../browser/...). -->
<RCC version="1.0">
  <qresource prefix="/config">
    <file alias="hotkeysConfig.json">../../common/config/hotkeysConfig.json</file>
    <file alias="infoConfig.json">../../common/config/infoConfig.json</file>
    <file alias="constants.json">../../common/config/constants.json</file>
    <file alias="accents.json">../../common/config/accents.json</file>
    <file alias="icons.json">../../common/config/icons.json</file>
    <file alias="iconMotion.json">../../common/config/iconMotion.json</file>
    <file alias="logoStage.json">../../common/config/logoStage.json</file>
    <file alias="motion.json">../../common/config/motion.json</file>
    <file alias="webcore.json">../../common/config/webcore.json</file>
    <file alias="iconsWebcore.json">../../common/config/iconsWebcore.json</file>
    <file alias="svgArt.json">../../common/config/svgArt.json</file>
    <file alias="layoutFields.json">../../common/config/layoutFields.json</file>
    <file alias="llm/systemPrompt.json">../../common/config/llm/systemPrompt.json</file>
    <file alias="llm/providers.json">../../common/config/llm/providers.json</file>
    <file alias="llm/opRegistry.json">../../common/config/llm/opRegistry.json</file>
    <file alias="themeTokens.json">../../common/config/themeTokens.json</file>
    <file alias="mediaTypes.json">../../common/config/mediaTypes.json</file>
    <file alias="net/blockedRanges.json">../../common/config/net/blockedRanges.json</file>
    <!-- The "Open in…" config TEMPLATE. An operator's own copy of it is per-machine and
         gitignored, so it cannot ride here (rcc needs every listed file at build time);
         the committed example carries the shape and the shipped defaults the surfaces
         agree on — the desktop URL scheme, and Telegram hidden until a bot name is set. -->
    <file alias="openInConfig.example.json">../../browser/js/config/openInConfig.example.json</file>
  </qresource>
  <qresource prefix="/qss">
    <!-- The app stylesheet, one piece per feature, %TOKEN% placeholders and all: themeStylesheet.cpp
         joins the pieces in its cascade order and buildStylesheet fills them in. Whitespace is
         load-bearing only in that the pinned hashes in tests/pins/stylesheets.txt cover the joined
         string: the leading newline (shell) and the trailing indent (overlays) are the raw literal
         this was lifted out of, byte for byte, and a piece's closing blank line is the gap before the next. -->
    <file alias="app/shell.qss">qss/app/shell.qss</file>
    <file alias="app/selectedLine.qss">qss/app/selectedLine.qss</file>
    <file alias="app/toolButtons.qss">qss/app/toolButtons.qss</file>
    <file alias="app/menus.qss">qss/app/menus.qss</file>
    <file alias="app/buttons.qss">qss/app/buttons.qss</file>
    <file alias="app/fields.qss">qss/app/fields.qss</file>
    <file alias="app/dock.qss">qss/app/dock.qss</file>
    <file alias="app/lists.qss">qss/app/lists.qss</file>
    <file alias="app/modals.qss">qss/app/modals.qss</file>
    <file alias="app/dialogs.qss">qss/app/dialogs.qss</file>
    <file alias="app/overlays.qss">qss/app/overlays.qss</file>
    <!-- The webcore skin's overlay, appended after the app sheet while the word is on (support/webcore). -->
    <file alias="webcore/chrome.qss">qss/webcore/chrome.qss</file>
    <file alias="webcore/menus.qss">qss/webcore/menus.qss</file>
    <file alias="webcore/fields.qss">qss/webcore/fields.qss</file>
    <file alias="webcore/chat.qss">qss/webcore/chat.qss</file>
    <file alias="webcore/checks.qss">qss/webcore/checks.qss</file>
    <file alias="webcore/tables.qss">qss/webcore/tables.qss</file>
    <file alias="webcore/windows.qss">qss/webcore/windows.qss</file>
    <file alias="webcore/scrollbars.qss">qss/webcore/scrollbars.qss</file>
    <file alias="webcore/notices.qss">qss/webcore/notices.qss</file>
  </qresource>
  <qresource prefix="/icons">
    <!-- Same icon as the browser app's favicon, so both front-ends share one
         look. Rendered by Qt's SVG icon engine (qt6-qtsvg). -->
    <file alias="appicon.svg">../../common/icons/favicon.svg</file>
    <!-- White check / dot drawn over the accent-filled checkbox & radio
         indicators (see support/theme.cpp buildStylesheet). PNG, not SVG: a QSS
         `image: url()` is loaded via QImageReader, which needs the separate qsvg
         image-format plugin for SVGs — PNG decoding is built in. The .svg files
         beside these are the editable source (regenerate with Qt's SVG renderer). -->
    <file alias="check.png">icons/check.png</file>
    <file alias="radio-dot.png">icons/radio-dot.png</file>
    <!-- Dark twins, for a checkbox/radio filled with a LIGHT accent (theme.cpp ON_ACCENT). -->
    <file alias="check-dark.png">icons/check-dark.png</file>
    <file alias="radio-dot-dark.png">icons/radio-dot-dark.png</file>
  </qresource>
</RCC>
