<!DOCTYPE RCC>
<!-- Embeds the browser app's config JSON directly so the desktop and browser
     read the SAME hotkeys / info / constants (single source of truth). Paths are
     relative to this .qrc file (desktop/resources/ -> ../../browser/...). -->
<RCC version="1.0">
  <qresource prefix="/config">
    <file alias="hotkeysConfig.json">../../browser/js/config/hotkeysConfig.json</file>
    <file alias="infoConfig.json">../../browser/js/config/infoConfig.json</file>
    <file alias="constants.json">../../browser/js/config/constants.json</file>
    <file alias="accents.json">../../browser/js/config/accents.json</file>
    <file alias="icons.json">../../browser/js/config/icons.json</file>
    <file alias="iconMotion.json">../../browser/js/config/iconMotion.json</file>
    <file alias="layoutFields.json">../../browser/js/config/layoutFields.json</file>
    <file alias="llm/systemPrompt.json">../../browser/js/config/llm/systemPrompt.json</file>
    <file alias="llm/providers.json">../../browser/js/config/llm/providers.json</file>
    <file alias="llm/opRegistry.json">../../browser/js/config/llm/opRegistry.json</file>
    <file alias="themeTokens.json">../../browser/js/config/themeTokens.json</file>
    <file alias="mediaTypes.json">../../browser/js/config/mediaTypes.json</file>
    <!-- The "Open in…" config TEMPLATE. An operator's own copy of it is per-machine and
         gitignored, so it cannot ride here (rcc needs every listed file at build time);
         the committed example carries the shape and the shipped defaults the surfaces
         agree on — the desktop URL scheme, and Telegram hidden until a bot name is set. -->
    <file alias="openInConfig.example.json">../../browser/js/config/openInConfig.example.json</file>
  </qresource>
  <qresource prefix="/qss">
    <!-- The app stylesheet, %TOKEN% placeholders and all (theme.cpp buildStylesheet
         fills them in). Whitespace is load-bearing only in that the pinned hashes in
         tests/pins/stylesheets.txt cover the whole string: the leading newline and the
         trailing indent are the raw literal this was lifted out of, byte for byte. -->
    <file alias="app.qss">app.qss</file>
  </qresource>
  <qresource prefix="/icons">
    <!-- Same icon as the browser app's favicon, so both front-ends share one
         look. Rendered by Qt's SVG icon engine (qt6-qtsvg). -->
    <file alias="appicon.svg">../../browser/favicon.svg</file>
    <!-- White check / dot drawn over the accent-filled checkbox & radio
         indicators (see support/theme.cpp buildStylesheet). PNG, not SVG: a QSS
         `image: url()` is loaded via QImageReader, which needs the separate qsvg
         image-format plugin for SVGs — PNG decoding is built in. The .svg files
         beside these are the editable source (regenerate with Qt's SVG renderer). -->
    <file alias="check.png">icons/check.png</file>
    <file alias="radio-dot.png">icons/radio-dot.png</file>
    <!-- Dark twins, for a checkbox/radio filled with a LIGHT accent (theme.cpp ON_ACCENT). -->
    <file alias="check-dark.png">icons/check-dark.png</file>
    <file alias="radio-dot-dark.png">icons/radio-dot-dark.png</file>
  </qresource>
</RCC>
