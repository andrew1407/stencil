      QListWidget, QTableWidget, QTreeWidget {
        background: %BG_CONTAINER%; color: %TEXT%; border: 1px solid %BORDER%;
        border-radius: 8px; alternate-background-color: %BG_CONTROLS%; outline: none;
      }
      QListWidget::item, QTreeWidget::item { padding: 4px; border-radius: 6px; }
      QListWidget::item:hover, QTreeWidget::item:hover { background: %ACCENT_SOFT%; }
      QListWidget::item:selected, QTableWidget::item:selected, QTreeWidget::item:selected { background: %ACCENT%; color: %ON_ACCENT%; }
      /* These rows paint fixed-colour text, so the solid selected fill swallowed them. */
      QListWidget#projectsList::item:selected, QListWidget#connList::item:selected {
        background: transparent; color: %TEXT%;
      }
      QListWidget#projectsList::item:selected:hover, QListWidget#connList::item:selected:hover {
        background: %ACCENT_SOFT%;
      }
      /* Rows are cards (browser .project-row), the list frameless. */
      QListWidget#projectsList { border: none; background: transparent; }
      /* 3px under the browser's 8px 10px: Qt's item metrics add slack (user decision). */
      QListWidget#projectsList::item {
        background: %INPUT_BG%; border-radius: 8px; padding: 5px 7px;
      }
      QListWidget#projectsList::item:selected { background: %INPUT_BG%; color: %TEXT%; }
      QListWidget#projectsList::item:hover,
      QListWidget#projectsList::item:selected:hover { background: %BG_INFO%; }
      /* Flat, as the browser's coordinates-table th. */
      QHeaderView::section {
        background: %ACCENT%;
        color: %ON_ACCENT%; border: 0; padding: 5px 6px;
      }
      QTableWidget { gridline-color: %BORDER%; }
      /* A hairline round every cell, so the accent header reads as separate cells. */
      /* One size across the panel, so header and tabs never fall back to the system font. */
      QTableWidget#pointsTable, QTableWidget#linesList {
        /* Browser .coordinates-table: a square box on its own ground, a hairline round each cell. */
        background: %BG_COORD_TABLE%; alternate-background-color: %BG_COORD_EVEN%;
        border: 1px solid %BORDER_COORD%; border-radius: 0;
        gridline-color: %BORDER_COORD%;
        selection-background-color: transparent;  /* the delegate strokes an outline instead */
        selection-color: %TEXT%;
        font-size: 13px;
      }
      QTableWidget#pointsTable QHeaderView::section, QTableWidget#linesList QHeaderView::section {
        border-right: 1px solid %BORDER%; border-bottom: 1px solid %BORDER%;
        padding: 6px 5px; font-weight: bold; font-size: 13px;
      }
      /* Browser .coord-tab: bold 12px in the muted ink, the open one lit with the accent rule. */
      QTabBar#selectionTabBar::tab {
        font-size: 12px; font-weight: bold; color: %MUTED%; padding: 3px 8px 4px;
        border-bottom: 2px solid transparent;
      }
      QTabBar#selectionTabBar::tab:hover { color: %TEXT_COORD_H3%; }
      QTabBar#selectionTabBar::tab:selected { color: %TEXT_COORD_H3%; border-bottom: 2px solid %ACCENT%; }
      /* The browser's own cell padding (layout.css .coordinates-table: 6px 5px). */
      QTableWidget#pointsTable::item, QTableWidget#linesList::item { padding: 6px 5px; }
      /* Both selection fills off, so only the delegate's outline shows. */
      QTableWidget#pointsTable::item:selected, QTableWidget#linesList::item:selected { background: transparent; color: %TEXT%; }
      QPushButton#pointDelBtn {
        background: transparent; border: none; border-radius: 6px; padding: 2px;
      }
      QPushButton#pointDelBtn:hover { background: %ACCENT_SOFT%; }

