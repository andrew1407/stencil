
      /* The editor is the browser's .container; the window around it keeps --bg-page. */
      QMainWindow { background: %BG_CONTAINER%; }
      QMainWindow#stencilWindow, QWidget#centralBackdrop { background: %BG_PAGE%; }
      /* VERTICAL bars stay a drag handle; the HORIZONTAL ones are 1px, so no strip sits between
         the Image Size bar and the canvas (user report). */
      QMainWindow::separator { background: %BG_CONTAINER%; width: %SEP_W%px; height: 1px; }
      /* The chat's gap: the browser's 10px of page between chat and editor (chat/touch.css). */
      QMainWindow#stencilWindow::separator { background: %BG_PAGE%; width: %CHAT_GAP%px; height: %CHAT_GAP%px; }
      /* A covered chat slide carries the gap in its own extent, so it slides from 0 (DockChrome::setChatGapless). */
      QMainWindow#stencilWindow[chatGapless="true"]::separator { width: 0px; height: 0px; }
      QMainWindow[fsEditor="true"], QMainWindow[fsEditor="true"]::separator { background: %BG_CANVAS%; }   /* fullscreen: the canvas ground */

      QToolBar {
        background: %BG_CONTROLS%;
        border: 0; border-bottom: 1px solid %BORDER%;
        /* The browser's 8px gap; 6 matches it once Qt's own button padding is counted. */
        spacing: 3px; padding: 4px 6px;
      }
      QToolBar::separator {
        width: 1px; background: %BORDER%; margin: 5px 6px; border-radius: 1px;
      }
      QWidget#toolWrapRow { background: transparent; }
      QFrame#toolWrapSep { background: %BORDER%; border: none; border-radius: 1px; }
      QToolBar QLabel { color: %MUTED%; background: transparent; padding: 0 2px; }
      /* Darker than %MUTED% in light: the plain grey read too faint on white (user report). */
      QLabel#sectionLabel { color: %SECTIONTITLE%; background: transparent; }
      QToolBar#headerToolbar { padding: 1px 6px 1px 11px; }   /* +5px left inset for the logo */
      /* In fullscreen the row hangs over the canvas: 5px more to stand on, and no hairline under it. */
      QToolBar[fsBar="true"] { padding-bottom: 9px; border-bottom: none; }

      QWidget#imageInfoBar {
        background: %BG_CONTROLS%;
        border: 0; border-bottom: 1px solid %BORDER%;
      }

      /* Browser .canvas-viewport border: marks off the bg-page gutter round a zoomed-out page. */
      QScrollArea#canvasViewport { border: 2px solid %BORDER_CANVAS%; }
      QScrollArea#canvasViewport[remoteEditing="true"] { border: 2px solid #d4a017; }
      /* Fullscreen: no frame. The browser's hairline lies on the screen's own edge and is never seen; here
         the canvas starts under the menu-bar band, where a hairline and its corners showed. */
      QScrollArea#canvasViewport[fsView="true"] { border: none; border-radius: 0px; }
      QScrollArea#canvasViewport[fsView="true"][remoteEditing="true"] { border: 1px solid #d4a017; border-radius: 0; }

      /* The View toggles' words (MainWindowToolbarView captioned): body text, not a muted caption. */
      QLabel#toggleCaption { color: %TEXT%; padding: 0; }
      QWidget[toolRow="true"] QCheckBox { spacing: 0; }   /* a bare box: its caption is the label beside it */
      /* Browser .coord-status: its own tooltip-bordered box, not the toolbar's. */
      QLabel#coordStatus {
        background: %BG_CONTROLS%; border: 1px solid %BORDER_TOOLTIP%; border-radius: 4px;
        color: %TEXT%; padding: 6px 10px;
        /* An outer gap off the window edge: the row's own left margin is 0. */
        margin-left: 3px;
      }

      /* Browser .drop-hint: dashed and accent-tinted, so it reads as a drop target. */
      QWidget#dropHintBar {
        background: %BG_DROP_HINT%; border: 1px dashed %BORDER_HINT%; border-radius: 4px;
      }
      QLabel#dropHintLabel { color: %MUTED%; background: transparent; }

