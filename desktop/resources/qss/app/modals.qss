      QDialog { background: %BG_CONTAINER%; color: %TEXT%; }
      /* Frameless, translucent: the #modalShell card is the browser's .app-modal surface. */
      QDialog[modalChrome="true"] { background: transparent; }
      QWidget#modalShell {
        background: %BG_CONTAINER%; border: 1px solid %BORDER%; border-radius: 10px;
      }
      QWidget#modalHeader { background: transparent; }

      /* The browser modal shell (.settings-header / .vs-section / .settings-footer); the close
         pill keeps its rounded-full radius and transparent face. */
      QLabel#modalTitle { font-size: 16px; font-weight: bold; background: transparent; }
      QPushButton#modalClosePill {
        background: transparent; border: 1px solid %BORDER%; border-radius: 13px;
        color: %TEXT%; font-size: 13px; padding: 4px 12px; min-height: 0px;
      }
      QPushButton#modalClosePill:hover { background: %ACCENT_SOFT%; border-color: %ACCENT_RING%; }
      QPushButton#modalClosePill:pressed { background: %ACCENT_SOFT2%; }
      QFrame#modalDivider {
        background: %BORDER%; border: none; min-height: 1px; max-height: 1px;
      }
      QLabel#modalSection {
        color: %MUTED%; font-weight: bold; font-size: 12px; letter-spacing: 1px;
        background: transparent;
      }
      /* 11px, not 12: Qt's font tracks wider, and the connect hint must fit one line at 560px. */
      QLabel#modalFooterHint { color: %MUTED%; font-size: 11px; background: transparent; }
      /* The crop dialog's size line under the preview (browser #crop-dims). */
      QLabel#cropDims { color: %MUTED%; font-size: 13px; background: transparent; }
      /* Browser .confirm-prompt-input; the line edit has the shared QLineEdit rule. */
      QPlainTextEdit#modalPromptText, QPlainTextEdit#descriptionText {
        background: %INPUT_BG%; color: %INPUT_TEXT%; border: 1px solid %BORDER%;
        border-radius: 8px; padding: 5px 7px;
        selection-background-color: %ACCENT%; selection-color: %ON_ACCENT%;
      }
      QPlainTextEdit#modalPromptText:hover:enabled, QPlainTextEdit#descriptionText:hover:enabled {
        border: 2px solid %ACCENT_RING%; padding: 4px 6px;
      }
      QPlainTextEdit#modalPromptText:focus { border: 2px solid %ACCENT%; padding: 4px 6px; }
      /* The browser's box-shadow focus ring as a wrapper frame, always 3px so nothing shifts. */
      QFrame#metaFieldRing { border: 3px solid transparent; border-radius: 11px; background: transparent; }
      QFrame#metaFieldRing[ringOn="true"] { border: 3px solid %ACCENT_RING%; }
      /* The thin half, on the fields the ring wraps. */
      QPlainTextEdit#descriptionText:focus { border: 1px solid %ACCENT%; padding: 5px 7px; }
      QLineEdit#keywordsInput:focus { border: 1px solid %ACCENT%; padding: 3px 8px; }
      /* The frame owns ONE accent hairline (browser .script-editor-wrap); the halo is its 3px ring. */
      QFrame#scriptEditorGlow, QFrame#scriptMenuGlow {
        background: transparent; border: 3px solid transparent; border-radius: 11px;
      }
      QFrame#scriptEditorGlow[hovered="true"],
      QFrame#scriptMenuGlow[hovered="true"] { border-color: %ACCENT_SOFT%; }
      /* Focus firms the ring; last wins (browser :focus-within over :hover). */
      QFrame#scriptEditorGlow[focused="true"],
      QFrame#scriptMenuGlow[focused="true"] { border-color: %ACCENT_SOFT2%; }
      QFrame#scriptEditorWrap, QFrame#scriptMenuWrap {
        background: %INPUT_BG%; border: 1px solid %ACCENT%; border-radius: 8px;
      }
      QPlainTextEdit#scriptText, QPlainTextEdit#scriptMenuText {
        background: transparent; color: %TEXT%; border: 1px solid transparent; padding: 0;
        selection-background-color: %ACCENT%; selection-color: %ON_ACCENT%;
      }
      /* The strip under it (browser .script-diag): muted until a run reports something. */
      QLabel#scriptDiag, QLabel#scriptMenuDiag {
        color: %MUTED%; font-size: 12px; background: transparent;
      }
      QLabel#scriptDiag[state="error"], QLabel#scriptMenuDiag[state="error"] { color: %DANGER%; }
      QLabel#scriptDiag[state="warn"], QLabel#scriptMenuDiag[state="warn"] { color: %WARNING%; }
      /* The flyout at MENU scale (browser ctx/script.css). */
      QWidget#scriptMenuPanel { background: transparent; }
      QLabel#scriptMenuDiag { font-size: 11px; padding: 4px 2px 0; }
      QWidget#scriptMenuPanel QPushButton {
        font-size: 12px; padding: 4px 9px; min-height: 14px;
      }
      /* As a 420-wide popover its bar takes the flyout's scale, so the five labels fit. */
      QWidget#popoverOverlay QDialog#stencilScriptDialog QPushButton[accentCta="true"],
      QWidget#popoverOverlay QDialog#stencilScriptDialog QPushButton[dangerCta="true"],
      QWidget#popoverOverlay QDialog#stencilScriptDialog QPushButton[successCta="true"] {
        font-size: 12px; padding: 4px 6px; min-height: 14px; icon-size: 13px;
      }
      /* Browser .chat-suggest: radius half its height; Qt squares off above that. */
      QPushButton#chatSuggestChip { padding: 4px 12px; border-radius: 14px; }
      /* At menu scale in the assistant flyout (browser .ctx-assist .chat-suggest). */
      QWidget#chatMenuPanel QPushButton#chatSuggestChip {
        font-size: 12px; padding: 4px 9px; min-height: 14px; border-radius: 12px;
      }
      /* Browser #ctx-assist-input; its height floor is chatMenuPanelParts.hpp's. */
      QPlainTextEdit#chatMenuInput {
        background: %INPUT_BG%; color: %INPUT_TEXT%; border: 1px solid %BORDER%;
        border-radius: 6px; padding: 6px 8px; font-size: 13px;
      }
      QPlainTextEdit#chatMenuInput:focus { border: 1px solid %ACCENT%; }
      /* …and the reason a value cannot be saved, under the field (promptModal validate). */
      QLabel#modalPromptReason { color: %DANGER%; font-size: 12px; background: transparent; }
      /* Browser .confirm-choose-select. */
      QComboBox#modalChooseSelect { padding: 7px 10px; border-radius: 8px; font-size: 13px; }
      /* Sized to its heading (browser .cs-dd trigger: 12px, 6px radius). */
      QComboBox#connKindFilter { font-size: 12px; border-radius: 6px; min-height: 14px; }
      QComboBox#modalChooseSelect:hover, QComboBox#modalChooseSelect:focus { padding: 6px 9px; }
      /* Browser #open-in-fallback-cmds. */
      QLabel#openInFallbackCmds {
        font-family: Menlo, Consolas, monospace; font-size: 12px; background: transparent;
      }
      /* The logo's accent-preset popover: menu-tight rows. */
      QDialog#accentPopover QPushButton {
        background: transparent; border: none; border-radius: 6px; text-align: left;
        padding: 5px 14px 5px 4px;
      }
      /* %ACCENT_SOFT% is the browser's 18% accent wash; a solid fill read as a block (user report). */
      QDialog#accentPopover QPushButton:hover {
        background: %ACCENT_SOFT%; color: %TEXT%;
      }
