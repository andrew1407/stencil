      /* ── Push buttons: gradient face, accent lift on hover, gradient primary ── */
      QPushButton {
        background: %BTN_FLAT%;
        color: %TEXT%; border: 1px solid %BORDER%; border-radius: 7px;
        padding: 6px 14px; min-height: 18px;
      }
      QPushButton:hover { border-color: %ACCENT%; background: %ACCENT_SOFT%; }
      QPushButton:pressed { background: %ACCENT_SOFT2%; }
      /* Accent CTA — the affirmative action button (makeModalCta/makeButtonBox) and the
         chat error cards' own CTAs (Configure provider / Reconnect to <host>): browser
         parity — a plain <button> there is accent-filled by default (layout.css). One
         dynamic-property selector, so the buttons' objectNames stay free for the tests. */
      QPushButton[accentCta="true"] {
        background: %ACCENT%; color: %ON_ACCENT%; border: none;
      }
      QPushButton[accentCta="true"]:hover {
        background: %ACCENT2%;
      }
      /* Fixed-width Album/Portrait swap (OpenImageDialog): a plain fixed-width QPushButton
         centres its icon+text as one block, so the icon drifts a little with every toggle
         between the two different-length words — left keeps the icon at one fixed inset
         instead (user report; browser twin: openImage.css's own left, not centred). */
      QPushButton#cropAlbumBtn { text-align: left; }
      /* The Open-Image file chooser is ONE control (browser twin: .oi-file): the BOX holds
         the outline and the rounding, and the two halves inside it are square and
         border-free, so the accent button butts against the path readout with no seam. */
      QFrame#oiFileBox {
        border: 1px solid %UI_OUTLINE%; border-radius: 7px; background: %INPUT_BG%;
      }
      QPushButton#oiChooseBtn {
        border: none; border-top-left-radius: 6px; border-bottom-left-radius: 6px;
        border-top-right-radius: 0; border-bottom-right-radius: 0; padding: 6px 14px;
      }
      QLineEdit#oiPathField {
        border: none; border-radius: 0; background: transparent; padding: 6px 12px;
      }
      /* The accent variant repeated: its selector ties QPushButton:disabled, so the disabled face needs its own rule. */
      QPushButton:disabled, QPushButton[accentCta="true"]:disabled {
        color: %DISABLED_TEXT%; background: %DISABLED_BG%; border-color: %BORDER%;
      }
      /* Danger button (e.g. the selection panel's Delete Line) — the browser's
         --danger red treatment, tuned per theme. */
      /* Run is the one GO action in the script editors, so it wears the browser's
         --success-cta green rather than the accent every other CTA uses — deeper than
         --success, so white ink reads on it. Dead, it greys like the rest. */
      QPushButton[successCta="true"] { background: %SUCCESS_CTA%; color: white; border: none; }
      QPushButton[successCta="true"]:hover { background: %SUCCESS_CTA2%; }
      QPushButton[successCta="true"]:disabled {
        background: %DISABLED_BG%; color: %MUTED%; border-color: %BORDER%;
      }
      QPushButton#dangerButton, QPushButton[dangerCta="true"] {
        background: %DANGER%; color: white; border: none;
      }
      QPushButton#dangerButton:hover, QPushButton[dangerCta="true"]:hover {
        background: %DANGER2%;
      }
      /* …and a DEAD one has to look it: these selectors outrank QPushButton:disabled above,
         so a disabled Clear All kept painting solid red and still read as pressable. */
      QPushButton#dangerButton:disabled, QPushButton[dangerCta="true"]:disabled {
        background: %DISABLED_BG%; color: %MUTED%; border-color: %BORDER%;
      }
      /* Muted, spaced section caption (selection panel "POINTS"/"MEASUREMENTS", and
         the context menu's own — MainWindowActions.cpp's makeSectionLabel), mirroring
         the browser's uppercased .ctx-sub-label. No padding of its own: every caller
         hosts it in a row whose OWN layout margins already place it (padding here
         would double up with those). */
      QLabel#panelSectionHeader {
        color: %MUTED%; font-weight: bold; font-size: 11px; letter-spacing: 1px;
      }

