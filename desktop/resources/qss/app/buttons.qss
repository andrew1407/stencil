      QPushButton {
        background: %BTN_FLAT%;
        color: %TEXT%; border: 1px solid %BORDER%; border-radius: 7px;
        padding: 6px 14px; min-height: 18px;
      }
      QPushButton:hover { border-color: %ACCENT%; background: %ACCENT_SOFT%; }
      QPushButton:pressed { background: %ACCENT_SOFT2%; }
      /* A plain browser <button> is accent-filled; one property selector leaves objectNames free. */
      QPushButton[accentCta="true"] {
        background: %ACCENT%; color: %ON_ACCENT%; border: none;
      }
      QPushButton[accentCta="true"]:hover {
        background: %ACCENT2%;
      }
      /* Left, so the icon keeps one inset as the word changes length (user report). */
      QPushButton#cropAlbumBtn { text-align: left; }
      /* One control (browser .oi-file): the box holds outline and rounding, the halves are square. */
      QFrame#oiFileBox {
        border: 1px solid %UI_OUTLINE%; border-radius: 7px; background: %INPUT_BG%;
      }
      QPushButton#oiChooseBtn {
        border: none; border-top-left-radius: 6px; border-bottom-left-radius: 6px;
        border-top-right-radius: 0; border-bottom-right-radius: 0; padding: 6px 14px;
      }
      QLineEdit#oiPathField {
        border: none; border-radius: 0; background: transparent; padding: 6px 12px;
      }
      /* The accent variant repeated: its selector ties QPushButton:disabled, so the disabled face needs its own rule. */
      QPushButton:disabled, QPushButton[accentCta="true"]:disabled {
        color: %DISABLED_TEXT%; background: %DISABLED_BG%; border-color: %BORDER%;
      }
      /* Run wears the browser's --success-cta green, deeper than --success so white reads on it. */
      QPushButton[successCta="true"] { background: %SUCCESS_CTA%; color: white; border: none; }
      QPushButton[successCta="true"]:hover { background: %SUCCESS_CTA2%; }
      QPushButton[successCta="true"]:disabled {
        background: %DISABLED_BG%; color: %MUTED%; border-color: %BORDER%;
      }
      QPushButton#dangerButton, QPushButton[dangerCta="true"] {
        background: %DANGER%; color: white; border: none;
      }
      QPushButton#dangerButton:hover, QPushButton[dangerCta="true"]:hover {
        background: %DANGER2%;
      }
      /* These selectors outrank QPushButton:disabled, so a dead danger button needs its own. */
      QPushButton#dangerButton:disabled, QPushButton[dangerCta="true"]:disabled {
        background: %DISABLED_BG%; color: %MUTED%; border-color: %BORDER%;
      }
      /* Browser .ctx-sub-label; no padding: every host row's own margins place it. */
      QLabel#panelSectionHeader {
        color: %MUTED%; font-weight: bold; font-size: 11px; letter-spacing: 1px;
      }

