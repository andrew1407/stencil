      }
    },
    "serverTarget": {
      "blocks": ["thisNetwork", "linkLocal", "cloudMetadata", "multicast", "reserved", "broadcast"],
      "blocksUnless": {
        "allowPrivate": [
          "loopback", "private", "cgnat", "ietf", "documentation", "benchmark", "uniqueLocal",
          "siteLocal", "localNat64", "teredo", "discard"
        ]
      }
    }
  }
