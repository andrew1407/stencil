    "name": "empty-line-object-gets-all-defaults",
    "divergences": {
      "cli": "SKIPS a line whose points read as empty (layout.zig: pts.items.len == 0 -> continue); the browser keeps the empty-points line",
      "mcp": "Line.points is required with no serde default — a bare {} line is rejected, not defaulted"
