  {
    "name": "junk-points-dropped-numeric-strings-coerced",
    "divergences": {
      "desktop": "lineFromJson keeps EVERY points[] entry and zero-fills: no numeric-string coercion (QJsonValue::toDouble never coerces \"3\") and no junk-point drop",
      "cli": "keeps every point OBJECT and defaults each missing/mis-typed coordinate to 0 (\"3\"/\"9\"/\"NaN\" -> 0); only non-object entries (5, null) are dropped",
      "mcp": "serde Point requires numeric x AND y — string coords, bare numbers, null and partial points are type errors, not skipped/coerced",
      "bot": "System.Text.Json binds points strictly: \"3\" (string) into double throws, so the whole layout parse returns null",
      "pystencil": "Point.from_dict coerces every entry (non-dict -> origin, missing coord -> 0, 'NaN' -> float nan)"
    },
    "sparse": [
      {
        "points": [
          {
            "x": "3",
            "y": 4
          },
          {
            "x": 1
          },
          {
            "x": "NaN",
            "y": 2
          },
          5,
          null,
          {
            "y": 7
          },
          {
            "x": 8,
            "y": "9"
          }
        ]
      }
    ],
    "expectSanitized": [
      {
        "points": [
          {
            "x": 3,
            "y": 4
          },
          {
            "x": 8,
            "y": 9
          }
        ],
        "locked": false
      }
    ],
    "expectFilled": [
      {
        "points": [
          {
            "x": 3,
            "y": 4
          },
          {
            "x": 8,
            "y": 9
          }
        ],
        "color": "#FFFF00",
        "thickness": 2,
        "pointSize": 4,
        "style": "solid",
        "locked": false,
        "fillColor": "transparent",
        "pointColor": ""
      }
    ]
  },
  {
    "name": "field-type-coercion-and-drops",
    "divergences": {
      "desktop": "no type coercion: thickness \"3.5\" (string) -> default 2 and locked 1 (number) -> default false (QJsonValue toDouble/toBool never coerce)",
      "cli": "typed JSON reader falls back to defaults on wrong-typed fields: thickness \"3.5\" -> 2 where browser coerces 3.5; locked 1 -> false where browser truthiness gives true",
      "mcp": "no type coercion — thickness \"3.5\" (string), locked 1, color 42 are serde type errors that reject the whole line list",
      "bot": "thickness \"3.5\" (string) and locked 1 (number) are type mismatches for the typed LayoutLine record — the whole parse returns null",
      "pystencil": "_as_str stringifies non-string color/fillColor (42 -> '42', false -> 'False') where the browser drops them to defaults"
    },
    "sparse": [
      {
        "points": [
          {
            "x": 1,
            "y": 2
          }
        ],
        "thickness": "3.5",
        "pointSize": "abc",
        "color": 42,
        "locked": 1,
        "fillColor": false,
        "style": null
      }
    ],
    "expectSanitized": [
      {
        "points": [
          {
            "x": 1,
            "y": 2
          }
        ],
        "thickness": 3.5,
        "locked": true
      }
    ],
    "expectFilled": [
      {
        "points": [
          {
            "x": 1,
            "y": 2
          }
        ],
        "color": "#FFFF00",
        "thickness": 3.5,
        "pointSize": 4,
        "style": "solid",
        "locked": true,
        "fillColor": "transparent",
        "pointColor": ""
      }
    ]
  },
