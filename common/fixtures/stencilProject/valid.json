  {
    "name": "layout-lines-hardened-session-keys-dropped",
    "divergences": {
      "desktop": "stores the layout object VERBATIM — session keys, junk line fields and string coords survive parse (hardening happens later in linesFromJson); the browser hardens at parse",
      "cli": "verdicts agree; re-stringifies the embedded layout RAW at parse (zoom/color/junk keys and string coords survive in layout_json); hardening happens later in layout.zig"
    },
    "file": "{\"format\":\"stencil-project\",\"version\":1,\"image\":{\"dataUrl\":\"data:image/png;base64,AAAA\"},\"layout\":{\"lines\":[{\"points\":[{\"x\":\"3\",\"y\":4}],\"junk\":true}],\"zoom\":2,\"color\":\"#123456\"}}",
    "expect": "ok",
    "project": {
      "name": "Untitled",
      "color": "",
      "keywords": [],
      "source": "",
      "resource": "",
      "blank": false,
      "blankColor": "",
      "image": {
        "dataUrl": "data:image/png;base64,AAAA",
        "ext": "png"
      },
      "layout": {
        "lines": [
          {
            "points": [
              {
                "x": 3,
                "y": 4
              }
            ],
            "locked": false
          }
        ]
      },
      "theme": null
    }
  },
