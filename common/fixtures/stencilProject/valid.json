  {
    "name": "invalid-theme-and-nonpositive-dims-dropped",
    "divergences": {
      "desktop": "performs no validity filtering: bogus ext \"...\", negative w -5 and an invalid theme {mode:\"blue\",accent:\"#12\"} all survive parse; the browser drops them",
