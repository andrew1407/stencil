# Build context is the repo root (the browser/CLI images both compile core/).
# Keep the context small: drop VCS, build outputs, caches and OS cruft.

.git
.github
**/.DS_Store

# Generated / build outputs
core/build
core/build-wasm
desktop/build
desktop/build-wasm
desktop/CMakeFiles
cli/zig-out
cli/zig-cache
cli/.zig-cache
cli/zig-pkg
browser/js/wasm

# Parts not used by the browser or CLI images
desktop
browser-extension
vscode-extension

# .NET bot: build output + local config. NEVER ship .env (it holds the bot token);
# the token is supplied at runtime via -e TELEGRAM_BOT_TOKEN. packages/ is the host's
# local NuGet restore cache — the image restores its own copy, so keep it out of context.
**/.env
bot/**/bin
bot/**/obj
bot/packages

# Go server: local dependency copy from `go mod vendor` (not shipped), its local data and
# binary, and the asset copies `go generate` writes in the image from common/config.
server/vendor
server/data
server/stencil-server
server/internal/config/assets/providers.json
server/internal/httpapi/assets/systemPrompt.json

# Docs / editor
**/*.md
.claude
# …except the one doc a binary embeds: mcp serves the .stc contract as a resource (include_str!).
!contracts/stc/stc-contract.md
