<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Canonical provider constants (default base URLs, chat timeout), embedded so the bot needs no repo checkout at run time. -->
    <EmbeddedResource Include="../../../common/config/llm/providers.json" Link="Assets/providers.json" />
    <!-- Canonical CSS colour-name table, so an unparseable colour is rejected before it reaches the CLI. -->
    <EmbeddedResource Include="../../../common/config/colorNames.json" Link="Assets/colorNames.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
