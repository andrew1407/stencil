<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Stencil.TelegramBot.Domain\Stencil.TelegramBot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical §4 system-prompt prose, embedded so the bot needs no repo checkout at run time. -->
    <EmbeddedResource Include="../../../common/config/llm/systemPrompt.json" Link="Assets/systemPrompt.json" />
    <!-- The shared op registry the plan validator is table-driven from (llm-contract.md §1–§13). -->
    <EmbeddedResource Include="../../../common/config/llm/opRegistry.json" Link="Assets/opRegistry.json" />
    <!-- The SSRF address table every fetch guard judges an address by. -->
    <EmbeddedResource Include="../../../common/config/net/blockedRanges.json" Link="Assets/blockedRanges.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
